{
  "version": 2,
  "name": "yeongjae-stock-screener",
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/*.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/stocks", "dest": "/api/stocks.py" },
    { "src": "/api/refresh-live", "dest": "/api/stocks.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
